<Page x:Class="Tuhvatshin_chudo_obuv.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы"
      FontFamily="Calibri">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Заказы"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="OrdersGrid"
                      Grid.Column="0"
                      Margin="0,0,10,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="OrdersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                        Binding="{Binding OrderNumber}"
                                        Width="55"/>
                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Клиент"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding Total, StringFormat={}{0:N2} ₽}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Состав заказа"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <StackPanel x:Name="OrderEditorPanel">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Дата:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <DatePicker x:Name="OrderDatePicker"
                                        Width="140"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="OrderItemsGrid"
                              Height="220"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              CellEditEnding="OrderItemsGrid_CellEditEnding"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Модель / товар и производство"
                                                Binding="{Binding ProductName}"
                                                IsReadOnly="True"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Размер"
                                                Binding="{Binding Size}"
                                                IsReadOnly="True"
                                                Width="70"/>
                            <DataGridTextColumn Header="Кол-во"
                                                Binding="{Binding Quantity, ValidatesOnExceptions=True}"
                                                IsReadOnly="True"
                                                Width="70"/>
                            <DataGridTextColumn Header="Цена"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2} ₽}"
                                                IsReadOnly="True"
                                                Width="95"/>
                            <DataGridTextColumn Header="Сумма"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}"
                                                IsReadOnly="True"
                                                Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="TotalTextBlock"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,10,0,0">
            <Button Content="Назад к товарам"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click"
                    DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button x:Name="SaveOrderButton"
                        Content="Сохранить заказ"
                        Margin="8,0,0,0"
                        Click="SaveOrderButton_Click"/>
                <Button x:Name="DeleteItemButton"
                        Content="Удалить позицию"
                        Margin="8,0,0,0"
                        Click="DeleteItemButton_Click"/>
                <Button x:Name="DeleteOrderButton"
                        Content="Удалить заказ"
                        Visibility="Collapsed"
                        Margin="8,0,0,0"
                        Click="DeleteOrderButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>