<Page x:Class="Tuhvatshin_chudo_obuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tuhvatshin_chudo_obuv"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1200" FontFamily="Calibri"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" Width="250" Height="30" FontSize="17">
                <TextBlock>Сортировка по умолчанию</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
            <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" Width="250" Margin="15" Height="30" FontSize="17" >
                <TextBlock>Фильтр по умолчанию</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обвуь</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
            </ComboBox>
        </StackPanel>
        <TextBox Name="TBSearch" TextChanged="TBSearch_TextChanged" Grid.Row="0" HorizontalAlignment="Left" FontSize="17" Margin="15" Width="250" Height="30" />
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="280,0,0,0" >
            <TextBlock Name="FIOTB" FontSize="15" FontWeight="Bold"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Вы авторизованы как: " FontSize="15" />
                <TextBlock Name="RoleTB" FontSize="15" FontWeight="Bold" />
            </WrapPanel>
           
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="1" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"></ColumnDefinition>
                            <ColumnDefinition Width="650"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Width="300" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.RowSpan="5">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                </Binding>
                            </Image.Source>
                        </Image>
                        <WrapPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Manufacturer}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text=" | " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding Name}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        </WrapPanel>
                        <TextBlock Text="{Binding Categories.CategoryName, StringFormat=Категория: {0}}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20" ></TextBlock>
                        <TextBlock Text="{Binding QuantityAvailability,StringFormat=В наличии: {0}}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.RowSpan="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20" ></TextBlock>
                        <TextBlock Text="{Binding Composition, StringFormat=Состав: {0}}" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <Button Content="Офрмить заказ"  Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="5" Name="BtnBuy" Click="BtnBuy_Click" ></Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Name="OrdersButton"
                    Content="Заказы"
                    Margin="10"
                    Visibility="Collapsed"
                    Click="OrdersButton_Click"/>
            <Button Name="AnalyticsButton"
                    Content="Аналитика"
                    Margin="10"
                    Visibility="Collapsed"
                    Click="AnalyticsButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
