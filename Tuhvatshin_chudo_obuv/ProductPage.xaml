<Page x:Class="Tuhvatshin_chudo_obuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tuhvatshin_chudo_obuv"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1200" FontFamily="Calibri"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
        </Grid.RowDefinitions>
        <ComboBox x:Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" BorderBrush="#70B2AF" BorderThickness="2"
                  FontSize="15" FontFamily="Calibri" Grid.Column="2" Margin="10,86,90,10">
            <TextBlock><Run Text="сортировка"/></TextBlock>
            <TextBlock><Run Text="от А до Я"/></TextBlock>
            <TextBlock><Run Text="от Я до А"/></TextBlock>
        </ComboBox>
        <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged"
                 FontSize="15" BorderBrush="#70B2AF" BorderThickness="2" RenderTransformOrigin="0.475,0.459" Grid.Column="1" Margin="75,86,75,10"/>
        <TextBlock Text="поиск по наименованию" FontSize="15" Foreground="#3E2C23" FontFamily="Calibri" Grid.Column="1" Margin="75,60,167,42"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="250,0,0,0" >
            <TextBlock Name="FIOTB" FontSize="15" FontWeight="Bold"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Вы авторизованы как: " FontSize="15" />
                <TextBlock Name="RoleTB" FontSize="15" FontWeight="Bold" />
            </WrapPanel>
           
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="1" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"></ColumnDefinition>
                            <ColumnDefinition Width="800"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Width="300" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.RowSpan="4">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <WrapPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Manufacturer}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text=" | " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding Name}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        </WrapPanel>
                        
                        <TextBlock Text="{Binding Categories.CategoryName, StringFormat=Категория: {0}}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20" ></TextBlock>
                        <TextBlock Text="{Binding TotalQuantity, StringFormat=В наличии: {0} шт.}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:0} рублей}" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" FontSize="30" ></TextBlock>
                        <TextBlock Text="{Binding Composition, StringFormat=Состав: {0}}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</Page>
